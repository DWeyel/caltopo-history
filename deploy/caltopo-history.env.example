# CalTopo service account (optional at install time; can be set later in Settings)
CALTOPO_CREDENTIAL_ID=
CALTOPO_CREDENTIAL_SECRET=

# Initial web administrator
APP_USERNAME=admin
APP_PASSWORD=
APP_SECRET_KEY=
APP_SECRET_KEY_FILE=/etc/caltopo-history.app-secret-key
INITIAL_ADMIN_PASSWORD_FILE=/var/lib/caltopo-history/.initial-admin-password

# IMPORTANT: true requires HTTPS at the browser-facing URL.
COOKIE_SECURE=true

# Service defaults / Settings fallbacks
POLL_INTERVAL_SECONDS=60
DISCOVERY_INTERVAL_SECONDS=300
FULL_VERIFY_EVERY=30
TZ=Europe/Berlin

DATABASE_URL=sqlite:////var/lib/caltopo-history/caltopo-history.db
CALTOPO_BASE_URL=https://caltopo.com
SOURCE_CODE_URL=https://github.com/DWeyel/caltopo-history
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
MAP_TILE_MAX_ZOOM=19
