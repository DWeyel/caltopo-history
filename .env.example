# -----------------------------------------------------------------------------
# CalTopo service-account credentials
# Optional here: v1.0.1 can be started first and configured in Settings > CalTopo.
# Environment values are used until an admin saves an override in the Settings UI.
# -----------------------------------------------------------------------------
CALTOPO_CREDENTIAL_ID=
CALTOPO_CREDENTIAL_SECRET=

# -----------------------------------------------------------------------------
# Initial web administrator
# APP_SECRET_KEY and APP_PASSWORD are generated automatically on a fresh Docker
# installation when left blank. APP_SECRET_KEY is persisted in /data/.app-secret-key.
# The temporary admin password is printed to the first-start container log and the
# plaintext handoff file is deleted after the password has been hashed into SQLite.
# Explicit values remain supported for automated deployments.
# -----------------------------------------------------------------------------
APP_USERNAME=admin
APP_PASSWORD=
APP_SECRET_KEY=

# Default: false, so a fresh installation works over HTTP as well as HTTPS.
# For an HTTPS deployment, enable Secure session cookies in Settings or set this to true.
# A value saved in Settings overrides this deployment fallback until the override is reset.
COOKIE_SECURE=false

# Optional standalone HTTPS deployment with compose.https.yaml + Caddy.
DOMAIN=

# -----------------------------------------------------------------------------
# Service defaults. These seed/fallback the Settings UI; operational values can be
# changed by an administrator in the application without editing this file.
# -----------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
DISCOVERY_INTERVAL_SECONDS=300
FULL_VERIFY_EVERY=30
TZ=Europe/Berlin
CALTOPO_BASE_URL=https://caltopo.com

SOURCE_CODE_URL=https://github.com/DWeyel/caltopo-history

MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
MAP_TILE_MAX_ZOOM=19

# Optional prebuilt image published by a GitHub Release. Leave blank to build locally.
IMAGE_REF=

# -----------------------------------------------------------------------------
# Docker networking
# -----------------------------------------------------------------------------
BIND_IP=127.0.0.1
HOST_PORT=8765
FORWARDED_ALLOW_IPS=*

# -----------------------------------------------------------------------------
# Persistent storage
# -----------------------------------------------------------------------------
DATA_VOLUME=caltopo_history_data
DATA_VOLUME_NAME=caltopo_history_data
