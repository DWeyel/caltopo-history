# -----------------------------------------------------------------------------
# Required CalTopo service-account credentials
# -----------------------------------------------------------------------------
CALTOPO_CREDENTIAL_ID=CHANGE_ME
CALTOPO_CREDENTIAL_SECRET=CHANGE_ME

# -----------------------------------------------------------------------------
# Initial web administrator
# APP_PASSWORD is used only when the database contains no users yet.
# Generate APP_SECRET_KEY with: openssl rand -hex 48
# -----------------------------------------------------------------------------
APP_USERNAME=admin
APP_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
APP_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# Keep true when the UI is served via HTTPS. Set false only for local HTTP tests.
COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Backup service defaults (global interval can later be changed in the UI)
# -----------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
DISCOVERY_INTERVAL_SECONDS=300
FULL_VERIFY_EVERY=30
TZ=Europe/Berlin
CALTOPO_BASE_URL=https://caltopo.com

# Public source-code location shown in the web UI. If you deploy a modified
# AGPL version, point this at the Corresponding Source for the version you run.
SOURCE_CODE_URL=https://github.com/DWeyel/caltopo-history

# Interactive map preview tile provider. OpenStreetMap's community tile service
# is intended for modest interactive use and is subject to its Tile Usage Policy.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
MAP_TILE_MAX_ZOOM=19

# -----------------------------------------------------------------------------
# Docker networking
# Default: only localhost on the Docker host can reach the app.
# Use 0.0.0.0 only if you intentionally want to publish it on all interfaces.
# -----------------------------------------------------------------------------
BIND_IP=127.0.0.1
HOST_PORT=8765

# Uvicorn trusts X-Forwarded-* from these proxy addresses. "*" is convenient
# behind a local/container reverse proxy; restrict this if the port is public.
FORWARDED_ALLOW_IPS=*

# -----------------------------------------------------------------------------
# Persistent storage
# Default is a Docker named volume. To use a host directory instead, set e.g.:
# DATA_VOLUME=./data
# -----------------------------------------------------------------------------
DATA_VOLUME=caltopo_history_data
DATA_VOLUME_NAME=caltopo_history_data
